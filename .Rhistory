# Load libraries
library(tidyverse)
selns_og <- read_delim("data/Raven_selections/6125.220928161024.Table.1.selections_intervals_JM.txt")
head(selns_og)
View(selns_og)
library(tidyverse)
# Load selection tables
# fine scale selections of each change in amplitude within vessel passages
selns_int_og <- read_delim("data/Raven_selections/6125.220928161024.Table.1.selections_intervals_JM.txt")
# Amplitude metrics (BB SPL, OL, TOL) at 1-second resolution
metrics_og <- read_csv("data/Sound_metrics/OLE_202209_coords_metrics.csv")
View(metrics_og)
View(metrics_og)
View(selns_int_og)
metrics_og$datetime[1]
metrics_og$datetime[1] %in% selns_int_og$`Begin Date Time`
metrics_og$datetime[59]
metrics_og$datetime[59] %in% selns_int_og$`Begin Date Time`
intervals_cat <- selns_int_og |>
full_join(metrics_og)
?cross_join
metrics_data <- metrics_og |>
mutate(begin_time = hms(datetime))
selns_data <- selns_int_og |>
mutate(datetime = as_datetime(`Begin Date Time`, format = "%Y-%m-%d %H:%M:%S"))
selns_data <- selns_int_og |>
mutate(datetime = as_datetime(`Begin Date Time`, format = "%Y/%m/%d %H:%M:%S"))
selns_data <- selns_int_og |>
mutate(datetime = as_datetime(`Begin Date Time`))
intervals_cat <- selns_data |>
full_join(metrics_og)
View(intervals_cat)
View(selns_data)
