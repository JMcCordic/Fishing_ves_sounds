select(seq_ID) |>
add_column(clust_ID = event_clust_tol125_cut)|>
mutate(fish_state_binom = case_when(grepl("fishing", seq_ID)==TRUE ~ 1,
TRUE ~ 0),
leaf_label = case_when(
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 21 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,2),"-",str_sub(seq_ID, 4,5)),
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 19 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,1),"-",str_sub(seq_ID, 3,3)),
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 20 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,2),"-",str_sub(seq_ID, 4,4)),
grepl("fishing", seq_ID)==TRUE & nchar(seq_ID) == 9 ~ paste0("Fishing, ","L", str_sub(seq_ID, 1,1)),
grepl("fishing", seq_ID)==TRUE & nchar(seq_ID) == 10 ~ paste0("Fishing, ","L", str_sub(seq_ID, 1,2)),
TRUE ~ paste0("Transit, ","L", str_sub(seq_ID, 1,1)))
)
)
# does vessel behavior differ by cluster membership?
# cluster ID = predictor
# vessel behav = response, coded as 1/0 (fishing/transit)
# add cluster labels to seq ID to associate w/fishing vs. transit
seq_clust_lab_tol125 <- selns_seq_wide_tol125 |>
select(seq_ID) |>
add_column(clust_ID = event_clust_tol125_cut)|>
mutate(fish_state_binom = case_when(grepl("fishing", seq_ID)==TRUE ~ 1,
TRUE ~ 0),
leaf_label = case_when(
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 21 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,2),"-",str_sub(seq_ID, 4,5)),
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 19 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,1),"-",str_sub(seq_ID, 3,3)),
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 20 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,2),"-",str_sub(seq_ID, 4,4)),
grepl("fishing", seq_ID)==TRUE & nchar(seq_ID) == 9 ~ paste0("Fishing, ","L", str_sub(seq_ID, 1,1)),
grepl("fishing", seq_ID)==TRUE & nchar(seq_ID) == 10 ~ paste0("Fishing, ","L", str_sub(seq_ID, 1,2)),
TRUE ~ paste0("Transit, ","L", str_sub(seq_ID, 1,1)))
)
event_clusters_tol125$order.lab <- seq_clust_lab_tol125$leaf_label[event_clusters_tol125$order]
clust_colors = viridis::mako(n = 3, begin = 0.25, end = 0.75)
dend_tol125 <- fviz_dend(event_clusters_tol125,
k = 3,
color_labels_by_k = TRUE,
k_colors = clust_colors,
labels_font = "bold",
labels_track_height = 3.25,
rect = TRUE,
rect_border = clust_colors,
rect_fill = TRUE,
lwd=1,
horiz = TRUE,
ggtheme = theme_bw()) +
theme(axis.text = element_text(size = 10),
axis.title.x = element_text(size = 12),
title = element_blank())
dend_tol125
ggsave("figs/dendrogram_k3_tol125.png", plot = dend_tol125, height=8, width=10, units = "in", dpi = 300)
# Fisher's Exact test to see if cluster assignment is related to fishing activity
fisher_tab_tol125 <- table(seq_clust_lab_tol125 |> ungroup() |> select(clust_ID, fish_state_binom))
fisher.test(fisher_tab_tol125)
# does vessel behavior differ by cluster membership?
