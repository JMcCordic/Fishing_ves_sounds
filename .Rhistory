### Make sequences into 4-panel plot
# maybe coerce into nicer df for geom_tile() instead of default sequence plot
#   -- if that works, could probably just do normal faceting!
BB_plot_seq <- selns_seq_BB |>
left_join(seq_clust_lab_BB) |>
filter(!is.na(leaf_label)) |>
rename(event_hilo = event_hilo_BB)|>
mutate(metric = "Broadband")
tol63_plot_seq <- selns_seq_tol63 |>
left_join(seq_clust_lab_tol63) |>
filter(!is.na(leaf_label)) |>
rename(event_hilo = event_hilo_tol63)|>
mutate(metric = "TOL63")
tol125_plot_seq <- selns_seq_tol125 |>
left_join(seq_clust_lab_tol125) |>
filter(!is.na(leaf_label)) |>
rename(event_hilo = event_hilo_tol125) |>
mutate(metric = "TOL125")
tol2k_plot_seq <- selns_seq_tol2k |>
left_join(seq_clust_lab_tol2k) |>
filter(!is.na(leaf_label)) |>
rename(event_hilo = event_hilo_tol2k)|>
mutate(metric = "TOL2000")
all_metrics_plot_seq <- rbind(BB_plot_seq, tol63_plot_seq, tol125_plot_seq, tol2k_plot_seq) |>
mutate(metric = factor(metric, levels = c("Broadband", "TOL63", "TOL125", "TOL2000")),
event_label = case_when(event_hilo == "high_long" ~ "HL",
event_hilo == "high_short" ~ "HS",
event_hilo == "low_long" ~ "LL",
event_hilo == "low_short" ~ "LS"))
ggplot(data = all_metrics_plot_seq,
aes(x = time_idx, y = leaf_label)) +
geom_tile(aes(fill = event_label),
color = "black")+
scale_fill_viridis_d(option = "B", begin = 0.2, end = 0.9)+
facet_grid(cols = vars(metric))+
labs(fill = "Event", x = "Sequence Event Index", y = "Sequence ID")+
theme_bw()+
theme(axis.text = element_text(face = "bold", size = 12),
axis.title = element_text(face = "bold", size = 14),
strip.text = element_text(face = "bold", size = 12),
legend.text = element_text(face = "bold", size = 12),
title = element_blank())
ggsave("figs/sequence_plots.png", height = 3.5, width = 12, units= "in", dpi = 300)
