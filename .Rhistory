library(tidyverse)
selns_og <- read_delim("data/Raven_selections/6125.220928161024.Table.1.selections_intervals_JM.txt")
head(selns_og)
selns_og |>
plot(Selection, `Dur 90% (s)`)
plot(selns_og$Selection, selns_og$`Dur 90% (s)`)
hist(selns_og$`Dur 90% (s)`)
