left_join(seq_clust_lab_BB) |>
filter(!is.na(leaf_label)) |>
mutate(metric = "Broadband")
tol63_plot_seq <- selns_seq_tol63 |>
left_join(seq_clust_lab_tol63) |>
filter(!is.na(leaf_label)) |>
mutate(metric = "TOL63")
# does vessel behavior differ by cluster membership?
# cluster ID = predictor
# vessel behav = response, coded as 1/0 (fishing/transit)
# add cluster labels to seq ID to associate w/fishing vs. transit
seq_clust_lab_tol63 <- selns_seq_wide_tol63 |>
select(seq_ID) |>
add_column(clust_ID = event_clust_tol63_cut)|>
mutate(fish_state_binom = case_when(grepl("fishing", seq_ID)==TRUE ~ 1,
TRUE ~ 0),
leaf_label = case_when(
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 21 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,2),"-",str_sub(seq_ID, 4,5)),
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 19 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,1),"-",str_sub(seq_ID, 3,3)),
grepl("Off_eff", seq_ID)==TRUE & nchar(seq_ID) == 20 ~ paste0("Maneuver, ","L",str_sub(seq_ID, 1,2),"-",str_sub(seq_ID, 4,4)),
grepl("fishing", seq_ID)==TRUE & nchar(seq_ID) == 9 ~ paste0("Fishing, ","L", str_sub(seq_ID, 1,1)),
grepl("fishing", seq_ID)==TRUE & nchar(seq_ID) == 10 ~ paste0("Fishing, ","L", str_sub(seq_ID, 1,2)),
TRUE ~ paste0("Transit, ","L", str_sub(seq_ID, 1,1)))
)
event_clusters_tol63$order.lab <- seq_clust_lab_tol63$leaf_label[event_clusters_tol63$order]
clust_colors = viridis::mako(n = 3, begin = 0.25, end = 0.75)
dend_tol63 <- fviz_dend(event_clusters_tol63,
k = 3,
color_labels_by_k = TRUE,
k_colors = clust_colors,
labels_font = "bold",
labels_track_height = 3.25,
rect = TRUE,
rect_border = clust_colors,
rect_fill = TRUE,
lwd=1,
horiz = TRUE,
ggtheme = theme_bw()) +
theme(axis.text = element_text(size = 10),
axis.title.x = element_text(size = 12),
title = element_blank())
dend_tol63
ggsave("figs/dendrogram_k3_tol63.png", plot = dend_tol63, height=8, width=10, units = "in", dpi = 300)
tol63_plot_seq <- selns_seq_tol63 |>
left_join(seq_clust_lab_tol63) |>
filter(!is.na(leaf_label)) |>
mutate(metric = "TOL63")
tol125_plot_seq <- selns_seq_tol125 |>
left_join(seq_clust_lab_tol125) |>
filter(!is.na(leaf_label)) |>
mutate(metric = "TOL125")
tol2k_plot_seq <- selns_seq_tol2k |>
left_join(seq_clust_lab_tol2k) |>
filter(!is.na(leaf_label)) |>
mutate(metric = "TOL2000")
all_metrics_plot_seq <- rbind(BB_plot_seq, tol63_plot_seq, tol125_plot_seq, tol2k_plot_seq)
View(all_metrics_plot_seq)
BB_plot_seq <- selns_seq_BB |>
left_join(seq_clust_lab_BB) |>
filter(!is.na(leaf_label)) |>
rename(event_hilo = event_hilo_BB)|>
mutate(metric = "Broadband")
tol63_plot_seq <- selns_seq_tol63 |>
left_join(seq_clust_lab_tol63) |>
filter(!is.na(leaf_label)) |>
rename(event_hilo = event_hilo_tol63)|>
mutate(metric = "TOL63")
tol125_plot_seq <- selns_seq_tol125 |>
left_join(seq_clust_lab_tol125) |>
filter(!is.na(leaf_label)) |>
